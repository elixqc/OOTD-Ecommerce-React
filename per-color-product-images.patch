+/* Product form: colors and photos */
+.form-hint {
+    margin-bottom: 12px;
+}
+
+.color-card {
+    padding: 16px;
+    margin-bottom: 16px;
+    border: 1px solid #e3e3e3;
+    border-radius: 10px;
+}
+
+.color-card-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+}
+
+.image-uploading {
+    opacity: 0.45;
+}
+
+.image-progress {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.image-main-badge {
+    position: absolute;
+    left: 4px;
+    bottom: 4px;
+    padding: 1px 8px;
+    border-radius: 10px;
+    background: #1f1f1f;
+    color: #fff;
+    font-size: 0.7rem;
+}
+
+.image-star {
+    position: absolute;
+    left: 4px;
+    bottom: 4px;
+    background: rgba(255, 255, 255, 0.9);
+}
+
+.image-drop {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 2px;
+    width: 110px;
+    height: 110px;
+    border: 2px dashed #bbb;
+    border-radius: 8px;
+    background: transparent;
+    color: #666;
+    font: inherit;
+    font-size: 0.8rem;
+    cursor: pointer;
+}
+
+.image-drop:hover,
+.image-drop.dragging {
+    border-color: var(--brand-accent);
+    background: rgba(200, 85, 61, 0.06);
+    color: var(--brand-accent);
+}
+
+/* Storefront: color picker with a thumbnail of each color */
+.color-options {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 10px;
+}
+
+.color-option {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 4px;
+    width: 72px;
+    padding: 0;
+    border: none;
+    background: none;
+    font: inherit;
+    font-size: 0.75rem;
+    cursor: pointer;
+}
+
+.color-option img {
+    width: 64px;
+    height: 64px;
+    object-fit: cover;
+    border-radius: 8px;
+    border: 2px solid transparent;
+}
+
+.color-option.selected img {
+    border-color: #1f1f1f;
+}
+
+.color-option:disabled {
